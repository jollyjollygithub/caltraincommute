#!/bin/sh
# Auto-bump the app's patch version on every commit.
#
# Reads AppInfo.version from CaltrainUpcoming/Schedule.swift, increments the patch
# component (0.5 -> 0.5.1 -> 0.5.2 ...), writes it back, and stages the change so
# the bump lands in the commit being made. Enabled per-clone with:
#     git config core.hooksPath .githooks
# Skip a single commit with `git commit --no-verify` if you need to.
set -e

FILE="CaltrainUpcoming/Schedule.swift"
[ -f "$FILE" ] || exit 0

current=$(sed -n 's/.*static let version = "\([0-9][0-9.]*\)".*/\1/p' "$FILE" | head -1)
[ -n "$current" ] || exit 0

major=$(printf '%s' "$current" | cut -d. -f1)
minor=$(printf '%s' "$current" | cut -d. -f2)
patch=$(printf '%s' "$current" | cut -d. -f3)
[ -n "$patch" ] || patch=0
patch=$((patch + 1))
new="$major.$minor.$patch"

# Escape dots in the search string so they match literally, then edit in place
# (BSD sed on macOS needs the empty '' argument after -i).
esc=$(printf '%s' "$current" | sed 's/\./\\./g')
sed -i '' "s/static let version = \"$esc\"/static let version = \"$new\"/" "$FILE"
git add "$FILE"
